---
import '../styles/main.css';

interface Props {
  title?: string;
}

const { title = 'Organisationsnummer' } = Astro.props;
const description = 'Validate Swedish organization numbers';
const image = 'https://organisationsnummer.dev/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="dns-prefetch" href="//fonts.googleapis.com/" />
    <link rel="dns-prefetch" href="//www.google-analytics.com" />
    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap.xml"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link
      rel="stylesheet"
      href="https://highlightjs.org/static/demo/styles/railscasts.css"
    />
    <link
      href="https://fonts.googleapis.com/css?family=Source+Sans+Pro&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <meta property="og:title" content="Organisationsnummer" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:title" content="Organisationsnummer" />
    <meta name="twitter:description" content={`${description}.`} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div>
      <div class="flex flex-col flex-1 md:justify-center max-w-3xl mx-auto p-5 w-full">
        <div>
          <h1 class="text-4xl md:text-5xl text-center text-gray-700">
            <img
              alt="Organisationsnummer"
              src="/apple-touch-icon.png"
              class="w-8 sm:w-12 inline-block"
            />{' '}
            organisationsnummer
          </h1>
        </div>
        <slot />
      </div>
      <div class="border-t border-solid border-gray-300 pt-5 my-5">
        <p class="text-center text-gray-600">
          Copyright © {new Date().getFullYear()} organisationsnummer and
          Contributors
        </p>
        <p class="text-center text-gray-600">
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://github.com/organisationsnummer/organisationsnummer.github.io"
            class="text-blue-500 hover:underline"
          >
            GitHub
          </a>{' '}
          -{' '}
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://twitter.com/sweidproject"
            class="text-blue-500 hover:underline"
          >
            Twitter
          </a>
        </p>
        <p class="text-center text-gray-600 mt-2">
          Fredrik "Frozzare" Forsmo (1991-2026) co-founded this project and
          helped shape its core. This site, and every library behind it, carries
          his work. He is missed.
        </p>
      </div>
    </div>
  </body>
</html>
